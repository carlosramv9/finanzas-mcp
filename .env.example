# Cadena de conexión de Neon (usar la URL CON pooling: host con "-pooler").
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Rama de Neon de DESARROLLO para pruebas de integración (nunca la principal).
DATABASE_URL_TEST=postgresql://usuario:password@ep-yyyy-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secreto de la ruta del endpoint MCP en fase 1 (mínimo 32 caracteres aleatorios).
# Generar con: openssl rand -base64 48 | tr -d '/+='
MCP_PATH_SECRET=
